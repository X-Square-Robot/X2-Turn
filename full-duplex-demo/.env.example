# Executables
PY=python3
COSY_PY=python3
VLLM_PY=python3
VOXTRAL_CLI=voxtral-realtime

# Public model IDs (local paths are also accepted)
VOXTRAL_MODEL=x-square/voxtral-mtp-turn-v3-delay0-zhen
# The canonical checkpoint above must be exported to the vLLM layout first.
VOXTRAL_VLLM_MODEL=/path/to/voxtral-mtp-turn-v3-delay0-zhen/final_vllm
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
COSY_MODEL=FunAudioLLM/CosyVoice2-0.5B

# Required for the default CosyVoice backend. Clone CosyVoice separately.
COSY_ROOT=/path/to/CosyVoice

# Service and GPU configuration
VAD_GPU=0
TTS_GPU=1
LLM_GPU=2
VLLM_PORT=8011
TTS_PORT=6017
DEMO_PORT=8443
DEMO_PUBLIC_HOST=localhost
VOXTRAL_GPU_MEMORY_UTILIZATION=0.35

# Optional service overrides
TURN_API_URL=ws://localhost:8000/turn
LLM_API_URL=http://localhost:6007/chat
TTS_API_URL=http://localhost:6017/tts

# Executables. These packages are installed from this checkout, not from PyPI.
PY=python3
VLLM_PY=python3
VOXTRAL_CLI=voxtral-realtime

# Public model IDs (local paths are also accepted)
VOXTRAL_MODEL=x-square-robot/X2-Turn-4B-0812
# Required when this launcher starts vLLM: an exported directory with
# consolidated.safetensors, not the Hugging Face model ID above.
VOXTRAL_VLLM_MODEL=/path/to/X2-Turn-4B-0812-vllm
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct

# Service and GPU configuration
TURN_GPU=0
# Legacy alias still accepted by start_demo.sh if TURN_GPU is unset:
# VAD_GPU=0
LLM_GPU=2
VLLM_PORT=8011
# Start the local Qwen3TTS-Streaming standalone engine first.
QWEN3_TTS_WS_URL=ws://127.0.0.1:50053/v1/ws
QWEN3_TTS_HEALTH_URL=http://127.0.0.1:50053/v1/capabilities
QWEN3_TTS_SPEAKER=serena
QWEN3TTS_CLIENT_SRC=/path/to/Qwen3TTS-Streaming/client/src
LLM_TOKEN_STREAM=1
DEMO_PORT=8443
DEMO_PUBLIC_HOST=localhost
# Local loopback. Set BIND_HOST=0.0.0.0 only when remote access is required.
BIND_HOST=127.0.0.1
VOXTRAL_GPU_MEMORY_UTILIZATION=0.35

# Optional service overrides
TURN_API_URL=ws://localhost:8000/turn
LLM_API_URL=http://localhost:6007/chat
